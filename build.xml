<?xml version="1.0" encoding="utf-8"?>
<!-- =========================================================================
     build.xml - CIAO DEFENSIVE EDITION
     =========================================================================

     !!! THIS FILE IS PART OF THE CIAO DEFENSIVE PROGRAMMING STYLE !!!
     !!! DO NOT SIMPLIFY, REMOVE COMMENTS, OR "CLEAN UP" THIS FILE !!!

     Purpose:
       Provides Ant build support for the C and C++ sources.
     Parameters:
       none
     Dependencies:
       PRJ from project.ini. Targets use ${app.name}.
     Why This Design:
       One file keeps the Ant targets. The product id stays in project.ini.
     CIAO Principles Applied:
       Intentional: every target has Purpose and Protection Rule.
     Protection Rule:
       DO NOT hardcode the project name. DO NOT remove these comments.
     ========================================================================= -->
<project name="ant-build" default="build" basedir=".">
    <property name="version" value="1.1.2"/>
    <!-- Define project properties -->
    <property file="project.ini"/>
    <!-- Missing-key fallback. This is the only product-id literal in this file. -->
    <property name="PRJ" value="cpp-logger"/>
    <property name="app.name" value="${PRJ}"/>
    <property name="src.dir" value="src"/>
    <property name="src.c.dir" value="${src.dir}/main/c"/>
    <property name="src.cpp.dir" value="${src.dir}/main/cpp"/>
    <property name="build.dir" value="target"/>
    <property name="build.debug.dir" value="target/exe/debug"/>
    <property name="version" value="1.1.2"/>
    <property name="author" value="july.wong@gmail.com"/>
    <property name="lib.versions" value="glib-2.0"/>
    <property name="project.sh" value="./project.sh"/>
    <property name="required.packages" value="build-essential pkg-config libglib2.0-dev"/>
    <property name="avoided.packages" value=""/>
    <condition property="os.windows">
        <os family="windows"/>
    </condition>
    <condition property="os.mac">
        <os family="mac"/>
    </condition>
    <condition property="os.linux">
        <and>
            <os family="unix"/>
            <not><os family="mac"/></not>
        </and>
    </condition>
    <condition property="os.skip.linux.compile">
        <or>
            <isset property="os.windows"/>
            <isset property="os.mac"/>
        </or>
    </condition>

    <!--
      Purpose: record glibc, uclibc, or musl on a Linux target host.
      Protection Rule: do not reject uClibc or musl. Do not run this probe on Windows or macOS.
    -->
    <target name="detect-libc" if="os.linux" description="Record the Linux libc: glibc, uclibc, or musl">
        <exec executable="sh" failonerror="false" outputproperty="libc.name">
            <arg value="-c"/>
            <arg value="if ldd --version 2&gt;&amp;1 | grep -qi uclibc; then echo uclibc; elif ldd --version 2&gt;&amp;1 | grep -qi musl; then echo musl; elif ldd --version 2&gt;&amp;1 | grep -qi glibc; then echo glibc; else echo glibc; fi"/>
        </exec>
        <echo message="Target host: linux/${libc.name}"/>
    </target>

    <target name="build-windows" if="os.windows" description="Windows target host. A Linux host skips this target">
        <echo message="Windows target host. Debug binary: ${build.debug.dir}/${app.name}"/>
    </target>

    <target name="build-macos" if="os.mac" description="macOS target host. A Linux host skips this target">
        <echo message="macOS target host. Debug binary: ${build.debug.dir}/${app.name}"/>
    </target>

    <!-- =========================================================================
     replace-property

     Purpose:
       Copies one property into another, replacing a token.
     Parameters:
       src, dest, replace, with
     Dependencies:
       Ant loadresource.
     Why This Design:
       Generated autotools text stays free of a pasted product id.
     CIAO Principles Applied:
       Intentional: the helper has Purpose and Protection Rule.
     Protection Rule:
       DO NOT hardcode the project name.
     ========================================================================= -->
    <macrodef name="replace-property" taskname="@{taskname}">
        <attribute name="src" />
        <attribute name="dest" default="" />
        <attribute name="replace" default="" />
        <attribute name="with" default="" />
        <sequential>
            <loadresource property="@{dest}">
                <propertyresource name="@{src}" />
                <filterchain>
                    <tokenfilter>
                        <filetokenizer/>
                        <replacestring from="@{replace}" to="@{with}"/>
                    </tokenfilter>
                </filterchain>
            </loadresource>
        </sequential>
    </macrodef>

    <target name="check-c-sub-main">
        <available file="${src.c.dir}/main.c" property="sub-main-exists"/>
    </target>

    <target name="check-cpp-sub-main">
        <available file="${src.cpp.dir}/main.cpp" property="sub-main-exists"/>
    </target>

    <!-- =========================================================================
     do-if-main

     Purpose:
       Runs the do-if-main target.
     Parameters:
       none
     Dependencies:
       Properties loaded from project.ini. Targets use ${app.name}.
     Why This Design:
       The target keeps its name.
     CIAO Principles Applied:
       Intentional: this target has Purpose and Protection Rule.
     Protection Rule:
       DO NOT rename this target. DO NOT hardcode the project name.
     ========================================================================= -->
    <target name="do-if-main" depends="check-c-sub-main, check-cpp-sub-main, check-c-source, check-cpp-source" if="sub-main-exists">
        <replace-property src="app.name" dest="app_name" replace="-" with="_"/>
        <condition property="src.main.dir" value="${src.c.dir}">
            <isset property="c.source.exists"/>
        </condition>

        <condition property="src.main.dir" value="${src.cpp.dir}">
            <isset property="cpp.source.exists"/>
        </condition>
        <condition property="src.main.file" value="main.c">
            <isset property="c.source.exists"/>
        </condition>

        <condition property="src.main.file" value="main.cpp">
            <isset property="cpp.source.exists"/>
        </condition>
        <echo file="${src.main.dir}/Makefile.am" append="false"><![CDATA[${app_name}_SOURCES += ${src.main.file}
]]></echo>        
    </target> 

    <target name="list-sources">
        <condition property="src.list.dir" value="${src.c.dir}">
            <isset property="c.source.exists"/>
        </condition>
        <condition property="src.list.dir" value="${src.cpp.dir}">
            <isset property="cpp.source.exists"/>
        </condition>
        <condition property="src.list.files" value="**/*.c">
            <isset property="c.source.exists"/>
        </condition>
        <condition property="src.list.files" value="**/*.cpp">
            <isset property="cpp.source.exists"/>
        </condition>

        <echo message="Listing all source files in ${src.list.dir}:"/>
        <fileset id="src.lists" dir="${src.list.dir}" includes="${src.list.files}"/> 
        <property name="tmp-sources" refid="src.lists"/>
        <replace-property src="tmp-sources" dest="tmp-src" replace=";" with=" ${src.list.dir}/"/>               
        <property name="src.file.lists" value="${src.list.dir}/${tmp-src}"/>
        <echo message="Source files: ${src.file.lists}"/>
    </target>

    <!-- =========================================================================
     generate-makefile

     Purpose:
       Runs the generate-makefile target.
     Parameters:
       none
     Dependencies:
       Properties loaded from project.ini. Targets use ${app.name}.
     Why This Design:
       The target keeps its name.
     CIAO Principles Applied:
       Intentional: this target has Purpose and Protection Rule.
     Protection Rule:
       DO NOT rename this target. DO NOT hardcode the project name.
     ========================================================================= -->
    <target name="generate-makefile" depends="check-c-source, check-cpp-source, list-sources">
        <replace-property src="app.name" dest="app_name" replace="-" with="_"/>
        <condition property="src.main" value="${src.c.dir}/main.c">
            <isset property="c.source.exists"/>
        </condition>

        <condition property="src.main" value="${src.cpp.dir}/main.cpp">
            <isset property="cpp.source.exists"/>
        </condition>

        <condition property="src.flag" value="CFLAGS">
            <isset property="c.source.exists"/>
        </condition>

        <condition property="src.flag" value="CXXFLAGS">
            <isset property="cpp.source.exists"/>
        </condition>
        <condition property="flag" value="${app_name}_${src.flag} = $(GTK_CFLAGS)&#10;${app_name}_LDADD = $(GTK_LIBS)" else="">
            <contains string="${lib.versions}" substring="gtk"/>
        </condition>
        <echo file="Makefile.am" append="false"><![CDATA[bin_PROGRAMS = ${app.name}
${app_name}_SOURCES = ${src.file.lists}
${flag}
]]></echo>
    </target>

    <!-- =========================================================================
     generate-configure

     Purpose:
       Runs the generate-configure target.
     Parameters:
       none
     Dependencies:
       Properties loaded from project.ini. Targets use ${app.name}.
     Why This Design:
       The target keeps its name.
     CIAO Principles Applied:
       Intentional: this target has Purpose and Protection Rule.
     Protection Rule:
       DO NOT rename this target. DO NOT hardcode the project name.
     ========================================================================= -->
    <target name="generate-configure">
        <condition property="pkg-check" value="[GTK], " else="">
            <contains string="${lib.versions}" substring="gtk"/>
        </condition>
        <condition property="ac-sub" value="AC_SUBST([GTK_CFLAGS])&#10;AC_SUBST([GTK_LIBS])&#10;" else="...">
            <contains string="${lib.versions}" substring="gtk"/>
        </condition>
        <echo file="configure.ac" append="false"><![CDATA[AC_INIT([${app.name}], [${version}], [${author}])
AM_INIT_AUTOMAKE([-Wall -Werror foreign subdir-objects])
AC_PROG_CC
AC_PROG_CXX  # Add this line to define CXX
PKG_CHECK_MODULES(${pkg-check}[${lib.versions}])
${ac-sub}AC_CONFIG_FILES([Makefile])
AC_OUTPUT
]]></echo>
    </target>

    <!-- =========================================================================
     prepare

     Purpose:
       Creates the debug directory.
     Parameters:
       none
     Dependencies:
       generate-makefile, generate-configure, and do-if-main.
     Why This Design:
       Later targets write under ${build.debug.dir}.
     CIAO Principles Applied:
       Caution: this target does not compile.
     Protection Rule:
       DO NOT rename this target. DO NOT hardcode the project name.
     ========================================================================= -->
    <target name="prepare" depends="generate-makefile,generate-configure,do-if-main" description="Creates the debug directory">
        <mkdir dir="${build.debug.dir}"/>
    </target>

    <!-- =========================================================================
     install

     Purpose:
       Generates project.sh when it is absent, then runs it.
     Parameters:
       none
     Dependencies:
       project.ini properties. An existing project.sh stays as it is.
     Why This Design:
       The generator must not replace the checked-in project.sh.
     CIAO Principles Applied:
       Caution: compile, build, and run do not depend on install.
     Protection Rule:
       DO NOT create src/main/c. DO NOT hardcode the project name.
     ========================================================================= -->
    <target name="check-project-sh">
        <available file="${project.sh}" property="project.sh.exists"/>
    </target>

    <target name="install-generate" depends="check-project-sh" unless="project.sh.exists">
        <echo file="${project.sh}" append="false"><![CDATA[#!/bin/sh
# Export project variables
export PRJ=${app.name}
export SRC=${src.dir}
export SRC_C=$SRC/main/c
export SRC_CPP=$SRC/main/cpp
export BUILD=${build.dir}
export BUILD_DEBUG=$BUILD/exe/debug
# Variable name LIB reserved for ./configure
export REQUIRED_LIBS="${lib.versions}"

# Array of prerequisite packages
REQUIRED_PACKAGES="${required.packages}"

# Array of avoided packages
AVOIDED_PACKAGES="${avoided.packages}"

apt_install() {
  RESULT=$(apt list --installed 2>&1 | grep "$2")
  if [ -z "$RESULT" ]; then 
    if [ -z "$1" ]; then
      sudo apt update
    fi
    sudo apt install -y -qq "$2"
    echo "1"
  else 
    echo "$1"
  fi 
}

apt_uninstall() {
  if apt list --installed 2>&1 | grep -q "$1"; then 
    sudo apt purge --autoremove -y -qq "$1"
  fi 
}

install() {
  UPD=0
  echo "$REQUIRED_PACKAGES" | tr ' ' '\n' | while read -r package; do
    if [ ! -z "$package" ]; then
      UPD=$(apt_install $UPD "$package")
    fi
  done

  echo "$AVOIDED_PACKAGES" | tr ' ' '\n' | while read -r package; do
    if [ ! -z "$package" ]; then
      apt_uninstall "$package"
    fi
  done
}

install
]]></echo>
        <chmod file="${project.sh}" perm="755"/>
    </target>

    <!-- =========================================================================
     install

     Purpose:
       Runs the install target.
     Parameters:
       none
     Dependencies:
       Properties loaded from project.ini. Targets use ${app.name}.
     Why This Design:
       The target keeps its name.
     CIAO Principles Applied:
       Intentional: this target has Purpose and Protection Rule.
     Protection Rule:
       DO NOT rename this target. DO NOT hardcode the project name.
     ========================================================================= -->
    <target name="install" depends="install-generate" description="Generates project.sh when it is absent, then runs it">
        <exec executable="${project.sh}"/>
    </target>

    <!-- =========================================================================
     make

     Purpose:
       Runs autoreconf, configure, and make.
     Parameters:
       none
     Dependencies:
       prepare.
     Why This Design:
       The autotools verb stays available beside the direct compile.
     CIAO Principles Applied:
       Intentional: the verb keeps the name make.
     Protection Rule:
       DO NOT rename this target. DO NOT hardcode the project name.
     ========================================================================= -->
    <target name="make" depends="prepare" description="Autotools path: autoreconf, configure, and make">
        <exec executable="autoreconf" 
            failonerror="false">
            <arg value="--install"/>
        </exec>
        <exec executable="./configure"/>
        <exec executable="make"/>
        <move file="${app.name}" tofile="${build.debug.dir}/${app.name}"/>
        <echo message="Please run: ${build.debug.dir}/${app.name}"/>
    </target>

    <target name="check-c-source">
        <available file="${src.c.dir}/main.c" property="c.source.exists"/>
    </target>

    <target name="check-cpp-source">
        <available file="${src.cpp.dir}/main.cpp" property="cpp.source.exists"/>
    </target>

    <!-- A missing src/main/c contributes no files. Do not create that directory. -->
    <target name="check-c-dir">
        <available file="${src.c.dir}" type="dir" property="c.dir.exists"/>
    </target>

    <!-- =========================================================================
     check-cpp-dir

     Purpose:
       Runs the check-cpp-dir target.
     Parameters:
       none
     Dependencies:
       Properties loaded from project.ini. Targets use ${app.name}.
     Why This Design:
       The target keeps its name.
     CIAO Principles Applied:
       Intentional: this target has Purpose and Protection Rule.
     Protection Rule:
       DO NOT rename this target. DO NOT hardcode the project name.
     ========================================================================= -->
    <target name="check-cpp-dir">
        <available file="${src.cpp.dir}" type="dir" property="cpp.dir.exists"/>
    </target>

    <target name="report-c-dir-present" depends="check-c-dir" if="c.dir.exists">
        <echo message="Check ${src.c.dir}: present"/>
    </target>

    <target name="report-c-dir-absent" depends="check-c-dir" unless="c.dir.exists">
        <echo message="Check ${src.c.dir}: absent. Contributes no files."/>
    </target>

    <target name="report-cpp-dir-present" depends="check-cpp-dir" if="cpp.dir.exists">
        <echo message="Check ${src.cpp.dir}: present"/>
    </target>

    <target name="report-cpp-dir-absent" depends="check-cpp-dir" unless="cpp.dir.exists">
        <echo message="Check ${src.cpp.dir}: absent. Contributes no files."/>
    </target>

    <target name="scan-cpp-in-c" depends="check-c-dir" if="c.dir.exists">
        <fileset id="cpp.in.c.lists" dir="${src.c.dir}" includes="**/*.cpp"/>
        <property name="tmp-cpp-in-c" refid="cpp.in.c.lists"/>
        <condition property="cpp.in.c.exists">
            <and>
                <isset property="tmp-cpp-in-c"/>
                <not>
                    <equals arg1="${tmp-cpp-in-c}" arg2=""/>
                </not>
            </and>
        </condition>
    </target>

    <!-- =========================================================================
     compile

     Purpose:
       Linux compile of .c and .cpp in one link on glibc, uClibc, or musl.
     Parameters:
       none
     Dependencies:
       detect-libc and the source-directory checks.
     Why This Design:
       A missing source directory contributes no files and is not created.
     CIAO Principles Applied:
       Caution: the cflags call and the libs call stay separate commands.
     Protection Rule:
       DO NOT create src/main/c. DO NOT hardcode the project name.
     ========================================================================= -->
    <target name="compile" unless="os.skip.linux.compile" depends="detect-libc,check-c-source,check-cpp-source,report-c-dir-present,report-c-dir-absent,report-cpp-dir-present,report-cpp-dir-absent,list-sources,scan-cpp-in-c" description="Linux compile of .c and .cpp in one link on glibc, uClibc, or musl">
        <condition property="compiler" value="gcc">
            <and>
                <isset property="c.source.exists"/>
                <not>
                    <isset property="cpp.source.exists"/>
                </not>
            </and>
        </condition>

        <condition property="compiler" value="g++">
            <and>
                <isset property="cpp.source.exists"/>
                <not>
                    <isset property="c.source.exists"/>
                </not>
            </and>
        </condition>

        <condition property="compiler" value="g++">
            <isset property="cpp.source.exists"/>
        </condition>

        <fail message="No valid source files found for compilation!" unless="compiler"/>

        <mkdir dir="${build.debug.dir}"/>
        <exec executable="pkg-config"
            failonerror="true"
            outputproperty="pkg.cflags">
            <arg value="--cflags"/>
            <arg line="${lib.versions}"/>
        </exec>
        <exec executable="pkg-config"
            failonerror="true"
            outputproperty="pkg.libs">
            <arg value="--libs"/>
            <arg line="${lib.versions}"/>
        </exec>

        <antcall target="compile-mixed-c-cpp"/>
        <antcall target="compile-single-language"/>
    </target>

    <!-- =========================================================================
     compile-mixed-c-cpp

     Purpose:
       Runs the compile-mixed-c-cpp target.
     Parameters:
       none
     Dependencies:
       Properties loaded from project.ini. Targets use ${app.name}.
     Why This Design:
       The target keeps its name.
     CIAO Principles Applied:
       Intentional: this target has Purpose and Protection Rule.
     Protection Rule:
       DO NOT rename this target. DO NOT hardcode the project name.
     ========================================================================= -->
    <target name="compile-mixed-c-cpp" if="cpp.in.c.exists">
        <replace-property src="tmp-cpp-in-c" dest="tmp-cpp-src" replace=";" with=" ${src.c.dir}/"/>
        <property name="cpp.file.lists" value="${src.c.dir}/${tmp-cpp-src}"/>
        <echo message="Using mixed C/C++ compilation"/>
        <echo message="C++ source files: ${cpp.file.lists}"/>
        <delete>
            <fileset dir="." includes="*.o"/>
        </delete>
        <exec executable="gcc" failonerror="true">
            <arg value="-std=c11"/>
            <arg value="-Wall"/>
            <arg value="-Wextra"/>
            <arg value="-g"/>
            <arg value="-O2"/>
            <arg value="-c"/>
            <arg line="${src.file.lists}"/>
            <arg line="${pkg.cflags}"/>
        </exec>
        <exec executable="g++" failonerror="true">
            <arg value="-std=c++17"/>
            <arg value="-Wall"/>
            <arg value="-Wextra"/>
            <arg value="-g"/>
            <arg value="-O2"/>
            <arg value="-c"/>
            <arg line="${cpp.file.lists}"/>
            <arg line="${pkg.cflags}"/>
        </exec>
        <pathconvert property="object.files" pathsep=" ">
            <fileset dir="." includes="*.o"/>
        </pathconvert>
        <exec executable="g++" failonerror="true">
            <arg line="${object.files}"/>
            <arg value="-o"/>
            <arg value="${build.debug.dir}/${app.name}"/>
            <arg line="${pkg.libs}"/>
            <arg value="-pthread"/>
        </exec>
        <delete>
            <fileset dir="." includes="*.o"/>
        </delete>
    </target>

    <!-- =========================================================================
     compile-single-language

     Purpose:
       Runs the compile-single-language target.
     Parameters:
       none
     Dependencies:
       Properties loaded from project.ini. Targets use ${app.name}.
     Why This Design:
       The target keeps its name.
     CIAO Principles Applied:
       Intentional: this target has Purpose and Protection Rule.
     Protection Rule:
       DO NOT rename this target. DO NOT hardcode the project name.
     ========================================================================= -->
    <target name="compile-single-language" unless="cpp.in.c.exists">
        <echo message="Using compiler: ${compiler}"/>
        <condition property="std.flag" value="-std=c11">
            <equals arg1="${compiler}" arg2="gcc"/>
        </condition>
        <property name="std.flag" value="-std=c++17"/>
        <exec executable="${compiler}" failonerror="true">
            <arg value="${std.flag}"/>
            <arg value="-Wall"/>
            <arg value="-Wextra"/>
            <arg value="-g"/>
            <arg value="-O2"/>
            <arg line="${src.file.lists}"/>
            <arg value="-o"/>
            <arg value="${build.debug.dir}/${app.name}"/>
            <arg line="${pkg.cflags}"/>
            <arg line="${pkg.libs}"/>
            <arg value="-pthread"/>
        </exec>
    </target>
    <!-- Target to move the compiled binary to the exec directory -->
    <target name="move" depends="compile">
        <mkdir dir="${build.debug.dir}"/> 
        <move file="${app.name}" tofile="${build.debug.dir}/${app.name}"/> <!-- Move to the final location -->
    </target>

    <!-- =========================================================================
     clean

     Purpose:
       Deletes generated build files.
     Parameters:
       none
     Dependencies:
       check-c-source and check-cpp-source.
     Why This Design:
       build does not depend on clean, so a build keeps the current tree.
     CIAO Principles Applied:
       Caution: this target does not delete project.sh.
     Protection Rule:
       DO NOT rename this target. DO NOT hardcode the project name.
     ========================================================================= -->
    <target name="clean" depends="check-c-source, check-cpp-source" description="Deletes generated build files">
        <echo message="Cleaning up generated files ...."/>
        <delete dir="autom4te.cache"/>
        <delete dir="${src.c.dir}/.deps"/>
        <delete dir="${src.cpp.dir}/.deps"/>
        <delete file="${src.c.dir}/Makefile.am"/>
        <delete file="${src.cpp.dir}/Makefile.am"/>
        <delete dir="${build.dir}"/>
        <delete dir="build"/>
        <delete dir=".gradle"/>
        <delete file="Makefile"/>
        <delete file="configure"/>
        <delete file="aclocal.m4"/>
        <delete file="config.log"/>
        <delete file="config.status"/>
        <delete file="Makefile.in"/>
        <delete file="install-sh"/>
        <delete file="compile"/>
        <delete file="configure~"/>
        <delete file="depcomp"/>
        <delete file="missing"/>
        <delete file="configuare.ac"/>
        <delete file="Makefile.am"/>
        <delete file="${src.c.dir}/.dirstamp"/>
        <delete file="${src.cpp.dir}/.dirstamp"/>
        <condition property="src.del.dir" value="${src.c.dir}">
            <isset property="c.source.exists"/>
        </condition>
        <condition property="src.del.dir" value="${src.cpp.dir}">
            <isset property="cpp.source.exists"/>
        </condition>
        <delete includeemptydirs="true">
            <fileset dir="${src.del.dir}" includes="**/*.o"/>
        </delete>
        <delete file="${src.c.dir}/Makefile.in"/>
        <delete file="${src.cpp.dir}/Makefile.in"/>
    </target>

    <!-- =========================================================================
     build

     Purpose:
       Builds the debug binary and does not launch it.
     Parameters:
       none
     Dependencies:
       compile on Linux for glibc, uClibc, and musl. build-windows on Windows. build-macos on macOS.
     Why This Design:
       One target is the default. run depends on it.
     CIAO Principles Applied:
       Anti-fragile: the binary path is ${build.debug.dir}/${app.name}.
     Protection Rule:
       DO NOT rename this target. DO NOT hardcode the project name.
     ========================================================================= -->
    <target name="build" depends="compile,build-windows,build-macos" description="Builds the debug binary and does not launch it">
        <echo message="Build completed. You can run the application with the command: ${build.debug.dir}/${app.name}"/>
    </target>

    <target name="check-exe">
      <available file="${build.debug.dir}/${app.name}" property="exe-exists"/>
    </target>

    <target name="build-if-not-exists" depends="check-exe" unless="exe-exists">
      <antcall target="build"/>
    </target>

    <!-- =========================================================================
     run

     Purpose:
       Depends on build, then executes the debug binary.
     Parameters:
       none
     Dependencies:
       build.
     Why This Design:
       The binary matches the sources before it starts.
     CIAO Principles Applied:
       Anti-fragile: run depends on build.
     Protection Rule:
       DO NOT rename this target. DO NOT hardcode the project name.
     ========================================================================= -->
    <target name="run" depends="build" description="Depends on build, then executes the debug binary">
        <exec executable="${build.debug.dir}/${app.name}"/>
    </target>
</project>